{
  "name": "front",
  "version": "1.0.2",
  "locale": "es_CL",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --ssl",
    "start:prod": "ng serve --configuration production --ssl",
    "start:dev": "ng serve --configuration dev --host 0.0.0.0 --ssl",
    "start:qa": "ng serve --configuration qa --ssl",
    "build": "ng build --configuration production",
    "watch": "ng build --watch --configuration production",
    "test": "set NODE_OPTIONS=--no-deprecation && ng test",
    "deploy": "set NODE_OPTIONS=--no-deprecation && pnpm version patch && ng build --configuration production && firebase deploy",
    "lint": "ng lint"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^22.2.3",
    "@angular/cdk": "^22.2.3",
    "@angular/common": "^22.2.3",
    "@angular/compiler": "^22.2.3",
    "@angular/core": "^22.2.3",
    "@angular/forms": "^22.2.3",
    "@angular/localize": "^22.2.3",
    "@angular/platform-browser": "^22.2.3",
    "@angular/platform-browser-dynamic": "^22.2.3",
    "@angular/router": "^22.2.3",
    "@ng-bootstrap/ng-bootstrap": "^21.0.0",
    "@ng-select/ng-select": "^24.2.1",
    "@popperjs/core": "^2.11.8",
    "bootstrap": "^5.3.3",
    "csvtojson": "^2.0.10",
    "jquery": "^3.6.1",
    "jsbarcode": "^3.11.6",
    "jwt-decode": "^4.0.0",
    "ngx-spinner": "^22.0.1",
    "pdfmake": "^0.2.15",
    "rxjs": "~7.8.0",
    "sweetalert2": "^11.15.10",
    "tslib": "^2.6.2",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^22.2.3",
    "@angular-eslint/builder": "^22.6.0",
    "@angular-eslint/eslint-plugin": "^22.6.0",
    "@angular-eslint/eslint-plugin-template": "^22.6.0",
    "@angular-eslint/schematics": "^22.6.0",
    "@angular-eslint/template-parser": "^22.6.0",
    "@angular/cli": "~22.2.3",
    "@angular/compiler-cli": "^22.2.3",
    "@eslint/js": "^9.39.5",
    "@types/jasmine": "~4.0.0",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "angular-eslint": "^22.6.0",
    "eslint": "^9.39.0",
    "istanbul-lib-instrument": "^6.0.3",
    "jasmine-core": "~4.1.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.1.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.0.0",
    "karma-jasmine-html-reporter": "~1.7.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "webpack": "^5.112.0"
  }
